{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-websearch-localllm",
  "version": "0.1.0",
  "description": "Self-contained web search + page-simplification provider for OpenCode's built-in websearch tool. Works with any model, including local ones.",
  "type": "module",
  "license": "MIT",
  "author": "xeaf",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "websearch",
    "search",
    "duckduckgo",
    "markdown"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build && npm test && npm run typecheck",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "cheerio": "^1.0.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.8.2"
  }
}
